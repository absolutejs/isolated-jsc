{
  "name": "@absolutejs/isolated-jsc",
  "version": "0.7.2",
  "description": "JavaScriptCore-native sandbox for Bun — heap-isolated execution for untrusted code, isolated-vm-shaped API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/isolated-jsc.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "isolated-jsc": "dist/doctor.js",
    "isolated-jsc-doctor": "dist/doctor.js"
  },
  "license": "CC BY-NC 4.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolutejs",
    "bun",
    "javascriptcore",
    "jsc",
    "sandbox",
    "isolated-vm",
    "isolate",
    "untrusted-code",
    "ai-agent"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/worker.ts src/doctor.ts --outdir dist --sourcemap --target=bun && tsc --project tsconfig.build.json",
    "test": "ISOLATED_JSC_BACKEND=worker bun test tests/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "release": "bun run format && bun run build && bun publish",
    "bench:proof": "bun bench/proof.ts",
    "example:agent-tool": "bun run build && bun examples/agent-tool.ts"
  },
  "peerDependencies": {
    "bun-types": ">= 1.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "BENCHMARKS.md",
    "MARKET_ANALYSIS.md",
    "MIGRATING_FROM_ISOLATED_VM.md",
    "SECURITY.md",
    "examples"
  ]
}
